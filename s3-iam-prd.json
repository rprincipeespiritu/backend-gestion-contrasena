{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPrdPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::gestion-contrasena",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["prd", "prd/*"]
        }
      }
    },
    {
      "Sid": "ObjectPrdPrefix",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::gestion-contrasena/prd/*"
    },
    {
      "Sid": "BucketCors",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketCors", "s3:PutBucketCors"],
      "Resource": "arn:aws:s3:::gestion-contrasena"
    }
  ]
}
